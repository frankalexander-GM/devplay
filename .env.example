# ============================================
# DevPlay · Variables de entorno (ejemplo)
# ============================================
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a git (está en .gitignore).
#
# En Coolify estas mismas variables se definen en el panel:
# Project → DevPlay → Environment (ver DEPLOY-COOLIFY.md)
# ============================================

# ── Base de datos (Supabase, pooler pgbouncer :6543) ──
DATABASE_URL=postgresql://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# ── NextAuth (genera el secreto con: openssl rand -base64 32) ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000   # en producción: https://devplay.online

# ── Chat en tiempo real (MISMO secreto en web y realtime) ──
# El backend firma tokens HMAC; el realtime-service los verifica.
REALTIME_SECRET=

# ── Correo (registro/recuperación — app-password de Gmail u otro SMTP) ──
# ⚠️ Sin esto el registro funciona en modo demo (código solo en logs).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevPlay <devplay.online@gmail.com>

# ── Opcionales ──
# Proxy interno del chat en Docker (el compose ya lo define):
# REALTIME_PROXY_URL=http://realtime:3003
# Aviso interno web→realtime en Docker (el compose ya lo define):
# REALTIME_INTERNAL_URL=http://realtime:3004
# URL pública del realtime si lo expones con dominio propio:
# NEXT_PUBLIC_REALTIME_URL=https://realtime.tu-dominio.com
# Supabase JS en el navegador (no se usan por ahora):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
