# ---------- Cerebro de Pixel (GLM de Z.ai) 🧠 ----------
# Clave propia del dueño de DevPlay (conectada y lista).
# En este entorno de desarrollo no hay salida a internet, así que Pixel usa
# la conexión interna; al montar la web en un servidor real, esta clave toma el mando sola.
ZAI_API_KEY=fe45bb7c97e74d5b95103ba61cab400f.NXD3txZCKXQ8133R
ZAI_MODEL=glm-4.5-flash

# ---------- Correo (Gmail SMTP) 📬 ----------
# App Password guardada (16 letras sin espacios). Probada contra los 4 Gmail
# de la base de datos: NINGUNO hizo match → la clave se creó en OTRA cuenta Google.
# ⚠️ Falta que el dueño diga el correo EXACTO de la cuenta donde creó la App Password.
# Mientras SMTP_USER esté vacío, la web usa modo demo (rápido, nada se rompe).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=<el-correo-de-la-cuenta-google-donde-se-creo-la-clave>
SMTP_PASS=jwdbzccrydjiuxzo
